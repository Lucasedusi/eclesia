# Core application (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email invitations (required only for sending invitations)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Eclesias

# Event checkout and Mercado Pago (optional for local development)
MERCADO_PAGO_ENV=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30
EVENT_CREDENTIAL_SECRET=
EVENT_CHECKOUT_SECRET=
EVENT_PAYMENT_MOCK_ENABLED=true

# Maintenance and observability (optional)
CRON_SECRET=
DOCUMENT_CLEANUP_DISABLED=false
DOCUMENT_PENDING_TTL_MINUTES=120
PERFORMANCE_TELEMETRY_ENABLED=true

# End-to-end testing (optional)
E2E_BASE_URL=
E2E_STORAGE_STATE=
E2E_TESTING=false
